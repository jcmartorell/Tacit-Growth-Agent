# Copia este archivo como .env.local (en tu computadora) y llena los valores.
# En Vercel se ponen los mismos nombres en Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-llave-anon-public
# SECRETA. Nunca la compartas ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-llave-service_role

# Dirección del panel. En tu computadora: http://localhost:3000
# En Vercel: la URL final, por ejemplo https://growth.tacit.guru (sin / al final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos que pueden entrar al panel, separados por coma
ALLOWED_EMAILS=jcmartorell@tacit.guru

# Fase 2: motor de prospección (todas SECRETAS)
APOLLO_API_KEY=pega-aqui-tu-llave-de-apollo
ANTHROPIC_API_KEY=pega-aqui-tu-llave-de-anthropic
# Valor aleatorio largo. Vercel lo usa para autorizar la corrida diaria.
CRON_SECRET=pega-aqui-un-valor-aleatorio

# Fase 3-4: LinkedIn (de tu app en linkedin.com/developers > Auth)
LINKEDIN_CLIENT_ID=pega-aqui-el-client-id
# SECRETA
LINKEDIN_CLIENT_SECRET=pega-aqui-el-client-secret
# Instagram no usa variables: el token se pega en el panel (Contenido) y se renueva solo.
